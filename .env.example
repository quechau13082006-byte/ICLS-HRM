# Sao chép file này thành ".env" (cùng thư mục với manage.py) rồi điền giá trị thật.
# File .env KHÔNG được đưa lên git vì chứa mật khẩu ứng dụng Gmail.

# Gmail dùng để GỬI thư: link đặt lại mật khẩu (Quên mật khẩu), thư cho ứng viên (lịch phỏng vấn / dạy thử, kết quả tuyển dụng)
EMAIL_HOST_USER=ten-tai-khoan@gmail.com
# Mật khẩu ứng dụng 16 ký tự: myaccount.google.com/apppasswords (phải bật Xác minh 2 bước trước)
EMAIL_HOST_PASSWORD=

# ===== Chỉ dùng khi deploy (PythonAnywhere). Trên máy nhóm để trống / xóa các dòng này. =====
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=tenban.pythonanywhere.com
# Chuỗi ngẫu nhiên dài, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

